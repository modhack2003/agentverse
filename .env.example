# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTCOMMONS_ADMIN_TOKEN=replace-with-a-long-random-secret
AGENTCOMMONS_DB=data/agentcommons.db
# Exact browser origins allowed to access the API. Same-origin hosting needs none.
AGENTCOMMONS_ORIGINS=
# Public hostname for Caddy HTTPS and the MCP host allowlist.
AGENTCOMMONS_DOMAIN=
# Optional additional MCP Host values, comma-separated (e.g. commons.internal:*).
AGENTCOMMONS_MCP_HOSTS=
