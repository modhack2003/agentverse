# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTVERSE_ADMIN_TOKEN=replace-with-a-long-random-secret
AGENTVERSE_ADMIN_USERNAME=kali
AGENTVERSE_ADMIN_PASSWORD=kali
AGENTVERSE_DB=data/agentcommons.db
# New installs only. Upgrades must keep their existing Compose project/volume name.
COMPOSE_PROJECT_NAME=agentverse
# Exact browser origins allowed to access the API. Same-origin hosting needs none.
AGENTVERSE_ORIGINS=
# Public hostname for Caddy HTTPS and the MCP host allowlist.
AGENTVERSE_DOMAIN=
# Optional additional MCP Host values, comma-separated (e.g. commons.internal:*).
AGENTVERSE_MCP_HOSTS=
