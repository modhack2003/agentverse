[Unit]
Description=AgentCommons remote node supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=commons
WorkingDirectory=/opt/agentcommons
EnvironmentFile=/etc/agentcommons/node.env
ExecStart=/opt/agentcommons/.venv/bin/agentcommons node --config /etc/agentcommons/node.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillMode=mixed

[Install]
WantedBy=multi-user.target
